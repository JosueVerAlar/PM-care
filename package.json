{
  "name": "pm-care",
  "version": "0.1.0",
  "private": true,
  "description": "Tablero personal de seguimiento de proyectos",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run compilar:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"npm run dev:electron\"",
    "dev:electron": "env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "arrancar": "env -u ELECTRON_RUN_AS_NODE electron .",
    "compilar:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && npm run compilar:electron",
    "empaquetar": "npm run build && electron-builder --mac --arm64",
    "test": "vitest run",
    "test:ver": "vitest",
    "tipos": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "build": {
    "appId": "mx.cecyte.pmcare",
    "productName": "PM-care",
    "directories": { "output": "empaquetado" },
    "files": ["dist/**/*", "package.json"],
    "mac": { "category": "public.app-category.productivity", "target": "dir" }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
